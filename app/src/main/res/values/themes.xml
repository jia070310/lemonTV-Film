<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LomenTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 避免半透明窗口在圆角处透出桌面/底层颜色 -->
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="Theme.LomenTV.Fullscreen" parent="Theme.LomenTV">
        <item name="android:windowFullscreen">true</item>
    </style>
    
    <style name="Theme.LomenTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_yellow</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/primary_yellow</item>
        <item name="postSplashScreenTheme">@style/Theme.LomenTV</item>
        <item name="android:windowBackground">@drawable/ic_splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
